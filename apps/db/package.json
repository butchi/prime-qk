{
  "name": "@prime-qk/db",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build && vite build --ssr src/entry-server.ts --outDir dist-ssr && tsx scripts/prerender.ts",
    "build:pages": "npm run build && npm run check:pages",
    "check:pages": "tsx scripts/check-pages.ts",
    "preview": "vite preview",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@prime-qk/catalog": "0.0.0",
    "vue": "^3.5.39"
  },
  "devDependencies": {
    "@types/node": "^24.0.13",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vue/tsconfig": "^0.7.0",
    "typescript": "~5.7.2",
    "vite": "^6.4.3",
    "vue-tsc": "^2.2.12",
    "tsx": "^4.20.3"
  }
}
